{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "mcp-env.d.ts", "types.ts", "utils.ts", "skill-extension.ts", "views/**/*", ".mcp-use/**/*.d.ts"],
  "exclude": ["node_modules", "dist", ".mcp-use"]
}
