{
  "name": "remotion-mcp-app",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "MCP App for creating animated Remotion video compositions with a live interactive player. Design videos through conversation with AI.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-apps",
    "mcp-use",
    "remotion",
    "video",
    "react",
    "animation"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=8192' mcp-use build",
    "build:inline": "NODE_OPTIONS='--max-old-space-size=8192' mcp-use build --inline",
    "dev": "npm run build:inline && mcp-use start --with-inspector",
    "dev:hmr": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.71",
    "@posthog/mcp": "^0.10.3",
    "@remotion/player": "4.0.505",
    "@remotion/transitions": "4.0.505",
    "esbuild": "^0.28.1",
    "mcp-use": "^2.0.4",
    "node-mocks-http": "^1.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.505",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.7.3"
  }
}
